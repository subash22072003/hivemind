# ---- Chain ----
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.fastnear.com
# Deployed HiveMind market contract account, e.g. market.yourname.testnet
CONTRACT_ID=

# ---- Master account (testnet). Only used by setup:keys to create sub-accounts. ----
MASTER_ACCOUNT_ID=
MASTER_PRIVATE_KEY=

# ---- Poster agent (can be a sub-account like poster.yourname.testnet) ----
POSTER_ACCOUNT_ID=
POSTER_PRIVATE_KEY=

# ---- Worker agents. Created by `npm run setup:keys` with function-call keys
# ---- limited to place_bid/submit_result on the market contract. ----
WORKER1_ACCOUNT_ID=
WORKER1_PRIVATE_KEY=
WORKER2_ACCOUNT_ID=
WORKER2_PRIVATE_KEY=
WORKER3_ACCOUNT_ID=
WORKER3_PRIVATE_KEY=

# ---- Brains (optional). Without a key the agents run in deterministic mock mode. ----
# Claim $10 free credits at https://nearbuilders.org/dashboard (or https://cloud.near.ai)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Check available models at https://docs.near.ai — e.g. deepseek-ai/DeepSeek-V3.1
NEAR_AI_MODEL=
